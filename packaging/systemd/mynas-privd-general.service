[Unit]
Description=LumoNAS general privileged operation worker
After=local-fs.target mynas-privd.service
Wants=mynas-privd.service

[Service]
Type=simple
ExecStart=/usr/lib/lumonas/mynas-privd --worker general --socket /run/mynas/general.sock
User=root
Group=mynas
RuntimeDirectory=mynas
RuntimeDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/mynas /etc/mynas /var/lib/mynas /srv/mynas /srv/pools
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETGID CAP_SETUID
AmbientCapabilities=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETGID CAP_SETUID
LockPersonality=true
MemoryDenyWriteExecute=true
MemoryMax=128M
CPUQuota=100%
TasksMax=64
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
