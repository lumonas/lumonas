[Unit]
Description=LumoNAS storage operation worker
After=local-fs.target mynas-privd.service
Wants=mynas-privd.service

[Service]
Type=simple
ExecStart=/usr/lib/lumonas/mynas-privd --worker storage --socket /run/mynas/storage.sock
User=root
Group=mynas
RuntimeDirectory=mynas
RuntimeDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/mynas /srv/disks /srv/pools /etc/mynas /var/lib/mynas/generated
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_RAWIO
AmbientCapabilities=CAP_SYS_ADMIN CAP_SYS_RAWIO
LockPersonality=true
MemoryDenyWriteExecute=true
MemoryMax=256M
CPUQuota=200%
TasksMax=128
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
