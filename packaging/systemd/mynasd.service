[Unit]
Description=LumoNAS management daemon
After=network-online.target docker.service mynas-privd.service
Wants=network-online.target
Requires=mynas-privd.service

[Service]
Type=simple
EnvironmentFile=-/etc/mynas/mynasd.env
ExecStart=/usr/lib/lumonas/mynasd
User=mynas
Group=mynas
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mynas /srv/mynas
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
MemoryMax=512M
CPUQuota=200%
TasksMax=256
TimeoutStopSec=15s
UMask=027

[Install]
WantedBy=multi-user.target
