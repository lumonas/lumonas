[Unit]
Description=LumoNAS power operation worker
After=local-fs.target lumonas-privd.service
Wants=lumonas-privd.service

[Service]
Type=simple
ExecStart=/usr/lib/lumonas/lumonas-privd --worker power --socket /run/lumonas/power.sock
User=root
Group=lumonas
RuntimeDirectory=lumonas
RuntimeDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/lumonas
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_SYS_BOOT
AmbientCapabilities=CAP_SYS_BOOT
LockPersonality=true
MemoryDenyWriteExecute=true
MemoryMax=128M
CPUQuota=100%
TasksMax=64
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
