[Unit]
Description=LumoNAS storage operation worker
After=local-fs.target lumonas-privd.service
Requires=lumonas-privd.service

[Service]
Type=simple
ExecStart=/usr/lib/lumonas/lumonas-privd --worker storage --socket /run/lumonas/storage.sock
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lumonas-privd-storage
User=root
Group=lumonas
RuntimeDirectory=lumonas
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/lumonas /srv/disks /srv/pools /etc/lumonas /var/lib/lumonas/generated /etc/systemd/system
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_RAWIO
AmbientCapabilities=CAP_SYS_ADMIN CAP_SYS_RAWIO
LockPersonality=true
MemoryDenyWriteExecute=true
MemoryMax=256M
CPUQuota=200%
TasksMax=128
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
