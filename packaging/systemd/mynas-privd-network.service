[Unit]
Description=LumoNAS network operation worker
After=network-online.target mynas-privd.service
Wants=mynas-privd.service

[Service]
Type=simple
ExecStart=/usr/lib/lumonas/mynas-privd --worker network --socket /run/mynas/network.sock
User=root
Group=mynas
RuntimeDirectory=mynas
RuntimeDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/mynas /etc/mynas /var/lib/mynas/generated
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
LockPersonality=true
MemoryDenyWriteExecute=true
MemoryMax=128M
CPUQuota=100%
TasksMax=64
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
