#!/bin/sh
set -eu

getent group lumonas >/dev/null 2>&1 || groupadd --system lumonas
id lumonas >/dev/null 2>&1 || useradd --system --gid lumonas --home-dir /var/lib/lumonas --no-create-home --shell /usr/sbin/nologin lumonas
install -d -o root -g lumonas -m 0750 /etc/lumonas
install -d -o root -g root -m 0755 /etc/exports.d /etc/ssh/sshd_config.d /etc/docker
install -d -o lumonas -g lumonas -m 0750 /var/lib/lumonas /var/lib/lumonas/secrets /var/lib/lumonas/generated /var/lib/lumonas/recovery /srv/lumonas /srv/lumonas/docker /srv/disks /srv/pools
if getent group docker >/dev/null 2>&1; then usermod -aG docker lumonas || true; fi

# Keep administrator-owned configuration across upgrades, but create a usable
# first-boot baseline when this is a fresh installation. Authentication is
# intentionally not pinned here: the daemon stays reachable until the first
# management user is created (onboarding) and then requires login. Set
# LUMONAS_AUTH_REQUIRED=false explicitly to opt out.
if [ ! -f /etc/lumonas/lumonasd.env ]; then
	cat >/etc/lumonas/lumonasd.env <<'ENV'
LUMONAS_DB_PATH=/var/lib/lumonas/lumonas.db
LUMONAS_RECOVERY_DIR=/var/lib/lumonas/recovery
LUMONAS_STACK_ROOT=/srv/lumonas/docker/stacks
LUMONAS_CATALOG_FILE=/usr/share/lumonas/catalog/apps.json
LUMONAS_SNAPRAID_CONFIG=/etc/lumonas/snapraid.conf
LUMONAS_PRIVD_SOCKET=/run/lumonas/privd.sock
ENV
	chown root:lumonas /etc/lumonas/lumonasd.env
	chmod 0640 /etc/lumonas/lumonasd.env
fi
if [ ! -f /etc/lumonas/lumonas-web.env ]; then
	cat >/etc/lumonas/lumonas-web.env <<'ENV'
LUMONAS_WEB_LISTEN=127.0.0.1:8081
LUMONAS_WEB_ROOT=/usr/share/lumonas/web
LUMONAS_API_URL=http://127.0.0.1:8080
# Enable HTTPS using the self-signed certificate generated below.
LUMONAS_WEB_TLS_CERT=/etc/lumonas/tls/server.crt
LUMONAS_WEB_TLS_KEY=/etc/lumonas/tls/server.key
LUMONAS_COOKIE_SECURE=true
ENV
	chown root:lumonas /etc/lumonas/lumonas-web.env
	chmod 0640 /etc/lumonas/lumonas-web.env
fi
if [ ! -f /etc/lumonas/runtime.env ]; then
	cat >/etc/lumonas/runtime.env <<'ENV'
LUMONAS_ZRAM_ENABLED=false
LUMONAS_TMPFS_ENABLED=false
ENV
	chown root:lumonas /etc/lumonas/runtime.env
	chmod 0640 /etc/lumonas/runtime.env
fi

# Provision an optional self-signed local certificate once, without replacing
# administrator-managed certificates on upgrades. HTTPS is opt-in by clearing
# the default listener and setting these paths in lumonas-web.env.
command -v openssl >/dev/null 2>&1 || { echo "openssl is required to provision the web certificate" >&2; exit 1; }
if [ ! -e /etc/lumonas/tls/server.key ]; then
	install -d -o root -g lumonas -m 0750 /etc/lumonas/tls
	if ! openssl req -x509 -newkey rsa:2048 -nodes -days 825 \
		-subj '/CN=lumonas.local' \
		-addext 'subjectAltName=DNS:lumonas.local,DNS:localhost,IP:127.0.0.1' \
		-keyout /etc/lumonas/tls/server.key -out /etc/lumonas/tls/server.crt >/dev/null 2>&1; then
		echo "failed to provision the web TLS certificate" >&2
		exit 1
	fi
fi
[ -s /etc/lumonas/tls/server.key ] && [ -s /etc/lumonas/tls/server.crt ] || {
	echo "web TLS certificate pair is incomplete" >&2
	exit 1
}
chown root:lumonas /etc/lumonas/tls/server.key /etc/lumonas/tls/server.crt
chmod 0640 /etc/lumonas/tls/server.key
chmod 0644 /etc/lumonas/tls/server.crt

# Apply bounded Docker JSON-file logging only when Docker has no administrator
# configuration yet. Existing daemon.json is never overwritten during install
# or upgrade.
if [ ! -e /etc/docker/daemon.json ] && [ -f /etc/docker/daemon.json.lumonas ]; then
	install -o root -g root -m 0644 /etc/docker/daemon.json.lumonas /etc/docker/daemon.json
fi

# Apply the SQLite schema before any service starts. Read only this one
# setting instead of sourcing the administrator-owned env file as shell code.
database_path=$(awk -F= '$1 == "LUMONAS_DB_PATH" { value=substr($0, index($0, "=") + 1) } END { if (value != "") print value }' /etc/lumonas/lumonasd.env)
database_path=${database_path:-/var/lib/lumonas/lumonas.db}
case "$database_path" in
	/*) ;;
	*) echo "LUMONAS_DB_PATH must be an absolute path" >&2; exit 1 ;;
esac
case "$database_path" in
	*[!A-Za-z0-9_./-]*) echo "LUMONAS_DB_PATH contains unsupported characters" >&2; exit 1 ;;
esac
runuser -u lumonas -- /usr/lib/lumonas/lumonas-migrate --db "$database_path"

# prerm stops the dependency graph before an upgrade so the newly unpacked
# binaries are used immediately. A live systemd host must fail the package
# transaction when the appliance cannot start; chroots without PID 1 retain a
# tolerant path so package extraction and image construction still work.
if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
	systemctl daemon-reload
	systemctl try-reload-or-restart systemd-journald.service
	systemctl enable lumonas-runtime.service lumonas-privd.service lumonas-privd-storage.service lumonas-privd-network.service lumonas-privd-power.service lumonas-privd-general.service lumonasd.service lumonas-web.service
	for unit in lumonas-runtime.service lumonas-privd.service lumonas-privd-storage.service lumonas-privd-network.service lumonas-privd-power.service lumonas-privd-general.service lumonasd.service lumonas-web.service; do
		systemctl start "$unit"
	done
else
	systemctl daemon-reload || true
	systemctl try-reload-or-restart systemd-journald.service || true
	systemctl enable lumonas-runtime.service lumonas-privd.service lumonas-privd-storage.service lumonas-privd-network.service lumonas-privd-power.service lumonas-privd-general.service lumonasd.service lumonas-web.service || true
fi
exit 0
