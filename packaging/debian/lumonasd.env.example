# Copy to /etc/lumonas/lumonasd.env and set strong local values before enabling auth/recovery.
LUMONAS_AUTH_REQUIRED=true
LUMONAS_ADMIN_PASSWORD=replace-with-a-12-character-or-longer-password
LUMONAS_RECOVERY_KEY=replace-with-an-independent-recovery-key
LUMONAS_COOKIE_SECURE=false
LUMONAS_SNAPRAID_CONFIG=/etc/lumonas/snapraid.conf
LUMONAS_UPS_NAMES=
LUMONAS_NOTIFY_WEBHOOK_URL=
LUMONAS_NOTIFY_NTFY_URL=
# Use off, disabled, or none to keep event notifications disabled.
LUMONAS_NOTIFY_MIN_SEVERITY=warning
LUMONAS_STACK_ROOT=/srv/lumonas/docker/stacks
LUMONAS_CATALOG_FILE=/usr/share/lumonas/catalog/apps.json
# Standard-base64 Ed25519 public key used to verify apps.json.sig.
# The matching private key lives only in the release secret store as
# LUMONAS_CATALOG_PRIVATE_KEY and is used by `make catalog-sign`.
LUMONAS_CATALOG_PUBLIC_KEY=LPTY6RxcteDjZ56sqAV0XwghSIOCYnXe5T85kSn0E1M=
# Catalog installs are refused unless apps.json.sig verifies against the key
# above. Set false only for local development against an unsigned catalog.
LUMONAS_REQUIRE_SIGNED_CATALOG=true
LUMONAS_PRIVD_SOCKET=/run/lumonas/privd.sock
LUMONAS_DOCKER_SOCKET=/var/run/docker.sock
LUMONAS_SNAPRAID_SCRUB_PERCENT=5
# Virtual machine installation media and disk images. Leave empty to use the
# libvirt image store default (/var/lib/libvirt/images/lumonas), which
# packaging/debian/postinst creates as lumonas:libvirt and which the lumonasd
# unit keeps writable. Only override to a directory that the daemon can write
# under that unit's ProtectSystem=strict sandbox.
LUMONAS_VM_MEDIA_DIR=
LUMONAS_VM_DISK_DIR=
# Comma-separated list of allowed CORS origins. Leave empty for same-origin only.
# Example: LUMONAS_CORS_ORIGINS=http://localhost:5173,https://nas.example.com
LUMONAS_CORS_ORIGINS=
