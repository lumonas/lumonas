# Copy to /etc/lumonas/lumonasd.env and set strong local values before enabling auth/recovery.
LUMONAS_AUTH_REQUIRED=true
LUMONAS_ADMIN_PASSWORD=replace-with-a-12-character-or-longer-password
LUMONAS_RECOVERY_KEY=replace-with-an-independent-recovery-key
LUMONAS_COOKIE_SECURE=false
LUMONAS_SNAPRAID_CONFIG=/etc/lumonas/snapraid.conf
LUMONAS_UPS_NAMES=
LUMONAS_NOTIFY_WEBHOOK_URL=
LUMONAS_NOTIFY_NTFY_URL=
LUMONAS_NOTIFY_MIN_SEVERITY=warning
LUMONAS_STACK_ROOT=/srv/lumonas/docker/stacks
LUMONAS_CATALOG_FILE=/usr/share/lumonas/catalog/apps.json
LUMONAS_PRIVD_SOCKET=/run/lumonas/privd.sock
LUMONAS_SNAPRAID_SCRUB_PERCENT=5
# Comma-separated list of allowed CORS origins. Leave empty for same-origin only.
# Example: LUMONAS_CORS_ORIGINS=http://localhost:5173,https://nas.example.com
LUMONAS_CORS_ORIGINS=
