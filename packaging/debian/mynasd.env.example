# Copy to /etc/mynas/mynasd.env and set strong local values before enabling auth/recovery.
MYNAS_AUTH_REQUIRED=true
MYNAS_ADMIN_PASSWORD=replace-with-a-12-character-or-longer-password
MYNAS_RECOVERY_KEY=replace-with-an-independent-recovery-key
MYNAS_COOKIE_SECURE=false
MYNAS_SNAPRAID_CONFIG=/etc/mynas/snapraid.conf
MYNAS_UPS_NAMES=
MYNAS_NOTIFY_WEBHOOK_URL=
MYNAS_NOTIFY_NTFY_URL=
MYNAS_STACK_ROOT=/srv/mynas/docker/stacks
MYNAS_CATALOG_FILE=/usr/share/lumonas/catalog/apps.json
# Set both values to enable local HTTPS on the web listener.
MYNAS_WEB_TLS_CERT=
MYNAS_WEB_TLS_KEY=
