# The management UI is LAN-facing by default; override with a specific
# interface when the appliance firewall policy requires narrower exposure.
LUMONAS_WEB_LISTEN=0.0.0.0:8081
# Local HTTPS certificate pair for the web listener.
# Keep this file readable only by root; do not place application secrets here.
LUMONAS_WEB_TLS_CERT=/etc/lumonas/tls/server.crt
LUMONAS_WEB_TLS_KEY=/etc/lumonas/tls/server.key
LUMONAS_COOKIE_SECURE=true
