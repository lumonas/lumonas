/lumonas-recover
# The remaining cmd/ binaries are built by `make` into bin/, but a bare
# `go build ./cmd/<name>` drops one in the repository root, where it is easy
# to commit by accident.
/lumonas-catalog-sign
/lumonas-migrate
/lumonas-recovery-fixture
/lumonas-update-fixture
/lumonas-workstation
/build/
/coverage/
.pnpm-store/
web/playwright-report/
web/test-results/
*.deb
*.iso
*.raw
*.sbom.json
*.sig
# The built-in app catalog signature is a release artifact that must be
# committed so lumonasd can verify the packaged catalog.
!catalog/apps.json.sig
build/qemu/work/
/data/
*.db
*.db-shm
*.db-wal
__pycache__/
